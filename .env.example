# Copy this file to .env before Lab 1.
# These defaults are intentionally local-lab credentials. Change them before
# exposing the VM to an untrusted network.

COMPOSE_PROJECT_NAME=observability-labs
BIND_ADDRESS=127.0.0.1

POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=orders_app_lab_password
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379
APP_HOST_PORT=8000

PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_lab_password
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_INTERNAL_METRICS_HOST_PORT=8888
OTEL_EXPORTED_METRICS_HOST_PORT=8889
NODE_EXPORTER_HOST_PORT=9100
OTEL_COLLECTOR_CONFIG_FILE=otel-collector-config.yaml

APP_ENVIRONMENT=lab
APP_LOG_LEVEL=INFO
APP_CACHE_TTL_SECONDS=300
APP_OTEL_ENABLED=true
APP_OTEL_TRACE_SAMPLE_RATIO=1.0

# Optional remote-write destination used with the example Mimir collector file.
MIMIR_REMOTE_WRITE_ENDPOINT=http://mimir:9009/api/v1/push
